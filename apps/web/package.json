{
  "name": "@ooxml-dev/web",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc --noEmit && vp build && bun scripts/prerender.ts",
    "build:prod": "bun --env-file=${OOXML_PROD_ENV_FILE:-../../.env.prod} scripts/validate-production-env.ts && bun --env-file=${OOXML_PROD_ENV_FILE:-../../.env.prod} run build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "deploy": "bun run build:prod && wrangler pages deploy dist --project-name=ooxml-dev --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "@clerk/react": "^6.14.1",
    "@clerk/shared": "^4.28.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.4.9",
    "fumadocs-ui": "^16.4.9",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "tailwindcss": "^4.1.18",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.61.0"
  }
}
