# Database connection
# For local development with Docker:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecma_spec

# For production with NeonDB:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/ecma_spec?sslmode=require

# Embedding API keys (only one required, based on chosen provider)
OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# VOYAGE_API_KEY=...
# COHERE_API_KEY=...

# Embedding configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# Auth for the experimental MCP 2026-07-28 endpoint at /mcp-v2.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Optional comma-separated azp values accepted from Clerk tokens.
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://ooxml.dev
